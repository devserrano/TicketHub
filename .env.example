# Copia este archivo como .env y ajusta los valores. NUNCA subas .env a GitHub.
# En local los valores por defecto de application.yml ya funcionan con docker-compose.

DB_URL=jdbc:postgresql://localhost:5432/tickethub
DB_USERNAME=tickethub
DB_PASSWORD=tickethub

JWT_SECRET=pon-aqui-un-secreto-largo-de-al-menos-32-caracteres

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=no-reply@tickethub.local

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
